<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetItemRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <ImageView
        android:id="@+id/widgetItemCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/widget_check_off" />
    <TextView
        android:id="@+id/widgetItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="@color/widgetText"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widgetItemMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/widgetMuted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
