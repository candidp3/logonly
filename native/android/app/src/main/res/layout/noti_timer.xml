<?xml version="1.0" encoding="utf-8"?>
<!-- 타이머 알림: 왼쪽 시간(위에 활동 이름) · 오른쪽 버튼 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/noti_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
        <Chronometer
            android:id="@+id/noti_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    </LinearLayout>
    <TextView
        android:id="@+id/noti_cancel"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/noti_btn_soft"
        android:text="취소"
        android:textSize="13sp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
    <TextView
        android:id="@+id/noti_stop"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/noti_btn_primary"
        android:text="종료하고 기록"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
