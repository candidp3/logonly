<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 알림바 '기록'·'취소'를 앱을 열지 않고 처리 -->
        <receiver android:name=".TimerActionReceiver" android:exported="false" />

        <!-- 홈 화면 위젯: 지금 시간대 루틴 -->
        <receiver android:name=".RoutineWidgetProvider" android:exported="false" android:label="로그온리 · 투데이">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/routine_widget_info" />
        </receiver>
        <receiver android:name=".RoutineSmallWidget" android:exported="false" android:label="로그온리 · 루틴 2×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver android:name=".RoutineBarWidget" android:exported="false" android:label="로그온리 · 루틴 4×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_routine_bar_info" />
        </receiver>
        <receiver android:name=".ProjectBarWidget" android:exported="false" android:label="로그온리 · 프로젝트 4×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_project_bar_info" />
        </receiver>
        <service android:name=".RoutineWidgetService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".RoutineBarService" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity android:name=".WidgetConfigActivity" android:exported="true"
            android:theme="@style/AppTheme.NoActionBar" android:label="위젯 설정"
            android:excludeFromRecents="true" android:taskAffinity="com.odaylab.logonly.widgetconfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
            <activity
            android:name=".WidgetInputActivity"
            android:exported="false"
            android:theme="@style/WidgetInputTheme"
            android:taskAffinity="com.odaylab.logonly.wq"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />
</application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 알림이 정해진 시간에 울리도록. 사용자가 폰 설정 '알람 및 리마인더'에서 허용해야 쓰임(안 하면 늦게 울릴 수 있음) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 숨참기 음성 안내: 폰의 음성 엔진(TTS)을 찾을 수 있게 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
